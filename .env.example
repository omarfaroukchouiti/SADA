# انسخ هذا الملف إلى .env.local وعدّل القيم حسب بيئة النشر.
# لا تكتب مفاتيح أو أسرار في هذا الملف؛ كل المتغيرات هنا غير سرية أو تُقرأ جانب الخادم فقط.

# الرابط العام للموقع، يُستخدم في بيانات metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# عنوان UmmahAPI. يُقرأ جانب الخادم فقط في src/lib/ummah.ts.
UMMAHAPI_BASE_URL=https://ummahapi.com/api

# عنوان الخادم المحلي الذي يستخدمه scripts/smoke.mjs للفحص (للتطوير فقط).
SADA_BASE=http://localhost:3000
